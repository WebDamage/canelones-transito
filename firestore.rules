rules_version = '2';

// Reglas sin Custom Claims (por decisión explícita: activar Custom Claims
// requiere Cloud Functions, que a su vez requieren pasar el proyecto de
// Firebase al plan Blaze — pide tarjeta aunque el uso real de un piloto
// termine costando $0. Ver functions/index.js y la sección de seguridad del
// README para la versión con Custom Claims, armada pero no activada).
//
// Sin un claim de servidor que diga "quién es quién", estas reglas solo
// pueden exigir "estar autenticado" (incluye sesiones anónimas) — no pueden
// verificar el rol real de quien escribe. Ese control queda a cargo de la
// interfaz (qué botones/pantallas se muestran según el rol guardado en
// localStorage), no de las reglas. Es la limitación de seguridad conocida
// del proyecto: cualquier sesión autenticada, técnicamente, podría llamar a
// Firestore directamente y saltarse la interfaz. Aceptable para un
// prototipo/piloto; antes de manejar datos reales de producción conviene
// evaluar activar Custom Claims (y el plan Blaze).
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de infracciones: lectura para cualquier sesión autenticada,
    // sin escritura desde el cliente (se carga con el script de seed).
    match /infracciones/{codigo} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Usuarios: lectura y escritura para cualquier sesión autenticada. La
    // pantalla de gestión de usuarios ya está protegida por rol en la
    // interfaz (ver App.jsx, ProtectedRoute), pero nada a nivel de regla
    // impide que alguien llame a Firestore directo — ver nota de arriba.
    match /usuarios/{cedula} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Multas: cualquier sesión autenticada puede crear y leer. El estado
    // administrativo solo se puede tocar mediante un update que además no
    // toque ningún otro campo — esto sí se puede exigir sin claims.
    match /multas/{multaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoAdministrativo']);
      allow delete: if false;
    }

    // Ubicación en vivo: cualquier sesión autenticada puede leer y escribir
    // (el opt-in real lo controla la interfaz del inspector).
    match /ubicaciones/{cedula} {
      allow read, write: if request.auth != null;
    }

    // Auditoría: cualquier sesión autenticada puede agregar un evento y leer
    // el historial (sin claims no se puede restringir la lectura a "solo
    // Administrador" del lado del servidor — la pantalla /panel/auditoria sí
    // lo hace en la interfaz). Sin edición ni borrado, para que sea un
    // registro de solo agregar.
    match /auditoria/{eventoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
