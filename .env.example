# Copiá este archivo a .env y completá con los datos de tu proyecto Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > Config del SDK).
# .env está en .gitignore: nunca subas tus credenciales reales al repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
