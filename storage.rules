rules_version = '2';

// Sin Custom Claims (ver la nota al principio de firestore.rules): no hay
// forma de verificar el rol real de quien sube un archivo, solo que esté
// autenticado. Fotos, video y firma de cada boleta viven en multas/{uuid}/*.
service firebase.storage {
  match /b/{bucket}/o {
    match /multas/{uuid}/{archivo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
